# Authenticated, version-specific Windows installer generated by voytty-release-tool.
param(
    [string]$InstallDir = (Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'voytty\bin'),
    [string]$TestBaseUrl = '',
    [switch]$NoPath
)
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$releaseTag = '@TAG@'
$baseUrl = '@BASE_URL@'
$manifestHash = '@MANIFEST_SHA256@'
$testMode = @TEST_MODE@
$artifacts = ConvertFrom-Json '@ARTIFACTS@'
if ($TestBaseUrl) {
    if (-not $testMode -or $TestBaseUrl -notmatch '^https://(localhost|127\.0\.0\.1):[0-9]+$') { throw 'Fixture URL is forbidden' }
    $baseUrl = $TestBaseUrl
}
if ([Environment]::OSVersion.Version.Build -lt 17763) { throw 'Windows 10 version 1809 or newer is required' }
# IsWow64Process2 reports the native machine even from an emulated PowerShell.
if (-not ('VoyttyInstallerPlatform' -as [type])) {
    Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public static class VoyttyInstallerPlatform {
    [DllImport("kernel32.dll", SetLastError = true)]
    [return: MarshalAs(UnmanagedType.Bool)]
    public static extern bool IsWow64Process2(IntPtr process, out ushort processMachine, out ushort nativeMachine);
}
'@
}
$processMachine = [System.UInt16]0; $nativeMachine = [System.UInt16]0
if (-not [VoyttyInstallerPlatform]::IsWow64Process2([IntPtr](-1), [ref]$processMachine, [ref]$nativeMachine)) { throw 'Unable to determine native Windows architecture' }
switch ($nativeMachine) {
    0x8664 { $target = 'x86_64-pc-windows-msvc' }
    0xAA64 { $target = 'aarch64-pc-windows-msvc' }
    default { throw "Unsupported Windows architecture: $nativeMachine (requires x64 or ARM64)" }
}
$artifact = @($artifacts | Where-Object { $_.target -eq $target })
if ($artifact.Count -ne 1) { throw 'Release is missing the native Windows target' }
$artifact = $artifact[0]
$InstallDir = [IO.Path]::GetFullPath($InstallDir)
$destination = Join-Path $InstallDir 'voytty.exe'
if (Test-Path -LiteralPath $destination) { throw 'voytty.exe already exists; use voytty update' }
Add-Type -AssemblyName System.Net.Http
$handler = New-Object System.Net.Http.HttpClientHandler
$handler.AllowAutoRedirect = $false
$client = New-Object System.Net.Http.HttpClient($handler)
$client.Timeout = [TimeSpan]::FromMinutes(10)
$client.DefaultRequestHeaders.UserAgent.ParseAdd('voytty-installer')
$temporary = Join-Path ([IO.Path]::GetTempPath()) ('voytty-install-' + [guid]::NewGuid().ToString('N'))
[IO.Directory]::CreateDirectory($temporary) | Out-Null
# Protect staging before any downloaded executable or authentication data exists.
$sid = [Security.Principal.WindowsIdentity]::GetCurrent().User
$acl = New-Object Security.AccessControl.DirectorySecurity
$acl.SetOwner($sid)
$acl.SetAccessRuleProtection($true, $false)
$acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($sid, 'FullControl', 'ContainerInherit,ObjectInherit', 'None', 'Allow')))
Set-Acl -LiteralPath $temporary -AclObject $acl
function Get-BoundedAsset([string]$Name, [long]$Maximum) {
    $response = $null; $inputStream = $null; $output = $null
    $watch = [Diagnostics.Stopwatch]::StartNew()
    $deadline = New-Object Threading.CancellationTokenSource
    $deadline.CancelAfter(600000)
    try {
        $url = "$baseUrl/$Name"
        for ($redirect = 0; ; $redirect++) {
            if (([uri]$url).Scheme -ne 'https') { throw 'HTTPS is required' }
            $response = $client.GetAsync($url, [Net.Http.HttpCompletionOption]::ResponseHeadersRead, $deadline.Token).GetAwaiter().GetResult()
            if ([int]$response.StatusCode -notin @(301, 302, 303, 307, 308)) { break }
            if ($redirect -ge 5 -or -not $response.Headers.Location) { throw 'Invalid asset redirect' }
            $url = (New-Object Uri([uri]$url, $response.Headers.Location)).AbsoluteUri
            $response.Dispose()
        }
        $response.EnsureSuccessStatusCode() | Out-Null
        if ($response.Content.Headers.ContentLength -gt $Maximum) { throw 'Asset exceeds download bound' }
        $inputStream = $response.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
        $output = [IO.File]::Open((Join-Path $temporary $Name), [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
        $buffer = New-Object byte[] 81920
        $count = 0L
        while ($true) {
            $pending = $inputStream.ReadAsync($buffer, 0, $buffer.Length, $deadline.Token)
            $remaining = [int][Math]::Max(1, [Math]::Min(30000, 600000 - $watch.ElapsedMilliseconds))
            if (-not $pending.Wait($remaining)) { throw 'Download stalled or exceeded its total deadline' }
            $read = $pending.GetAwaiter().GetResult()
            if ($read -eq 0) { break }
            $count += $read
            if ($count -gt $Maximum -or $watch.Elapsed.TotalSeconds -gt 600) { throw 'Download exceeded its bound' }
            $output.Write($buffer, 0, $read)
        }
        $output.Flush($true)
        return $count
    } finally {
        $deadline.Cancel(); $deadline.Dispose()
        if ($output) { $output.Dispose() }; if ($inputStream) { $inputStream.Dispose() }; if ($response) { $response.Dispose() }
    }
}
try {
    $null = Get-BoundedAsset 'voytty-release.json' 65536
    $manifest = Join-Path $temporary 'voytty-release.json'
    if ((Get-FileHash -LiteralPath $manifest -Algorithm SHA256).Hash.ToLowerInvariant() -ne $manifestHash) { throw 'Manifest hash mismatch' }
    if ((Get-BoundedAsset 'voytty-release.json.sig' 64) -ne 64) { throw 'Invalid manifest signature length' }
    $length = Get-BoundedAsset $artifact.filename $artifact.length
    $archive = Join-Path $temporary $artifact.filename
    if ($length -ne $artifact.length -or (Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne $artifact.sha256) { throw 'Archive authentication failed' }
    $entries = @(& tar.exe -tzf $archive)
    if ($LASTEXITCODE -ne 0 -or $entries.Count -ne 1 -or $entries[0] -cne 'voytty.exe') { throw 'Invalid native archive inventory' }
    & tar.exe -xzf $archive -C $temporary
    if ($LASTEXITCODE -ne 0) { throw 'Unable to extract native archive' }
    $candidate = Join-Path $temporary 'voytty.exe'
    $identity = & $candidate --internal-release-self-check | ConvertFrom-Json
    if ($LASTEXITCODE -ne 0 -or $identity.build.target -cne $target -or ('v' + $identity.build.version) -cne $releaseTag) { throw 'Candidate identity mismatch' }
    & $candidate --internal-release-verify $manifest (Join-Path $temporary 'voytty-release.json.sig')
    if ($LASTEXITCODE -ne 0) { throw 'Release signature verification failed' }
    if (-not (Test-Path -LiteralPath $InstallDir)) { [IO.Directory]::CreateDirectory($InstallDir) | Out-Null }
    if ((Get-Item -LiteralPath $InstallDir).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Install directory must not be a reparse point' }
    & $candidate --internal-release-install $destination
    if ($LASTEXITCODE -ne 0) { throw 'Atomic installation failed' }
    if (-not $NoPath) {
        if (@($env:Path -split ';') -notcontains $InstallDir) { $env:Path += ";$InstallDir" }
    }
    Write-Output "Add $InstallDir to your user PATH for future terminals."
    Write-Output "Installed voytty $releaseTag for $target to $destination. Run voytty setup."
} finally {
    $client.Dispose(); $handler.Dispose()
    Remove-Item -LiteralPath $temporary -Recurse -Force
}
