# Authenticated, version-specific Windows installer generated by voytty-release-tool.
param(
    [string]$InstallDir = (Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'voytty\bin'),
    [string]$TestBaseUrl = '',
    [switch]$NoPath
)
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
# Preserve the OS TLS policy (including TLS 1.3) on newer runtimes.
if ([int][Net.ServicePointManager]::SecurityProtocol -ne 0) {
    [Net.ServicePointManager]::SecurityProtocol = ([int][Net.ServicePointManager]::SecurityProtocol -band 12288) -bor [int][Net.SecurityProtocolType]::Tls12
}
$releaseTag = '@TAG@'
$baseUrl = '@BASE_URL@'
$manifestHash = '@MANIFEST_SHA256@'
$testMode = @TEST_MODE@
$artifacts = ConvertFrom-Json '@ARTIFACTS@'
if ($TestBaseUrl) {
    if (-not $testMode -or $TestBaseUrl -notmatch '^https://(localhost|127\.0\.0\.1):[0-9]+$') { throw 'Fixture URL is forbidden' }
    $baseUrl = $TestBaseUrl
}
if ([Environment]::OSVersion.Version.Build -lt 17763) { throw 'Windows 10 version 1809 or newer is required' }
# IsWow64Process2 reports the native machine even from an emulated PowerShell.
if (-not ('VoyttyInstallerPlatform' -as [type])) {
    Add-Type -TypeDefinition @'
using System;
using System.IO;
using System.IO.Compression;
using System.Runtime.InteropServices;
using System.Text;
public static class VoyttyInstallerPlatform {
    [StructLayout(LayoutKind.Sequential)]
    struct SecurityAttributes { public int Length; public IntPtr Descriptor; public int Inherit; }

    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    static extern bool CreateDirectoryW(string path, ref SecurityAttributes attributes);

    public static void CreatePrivateDirectory(string path, byte[] descriptor) {
        var pinned = GCHandle.Alloc(descriptor, GCHandleType.Pinned);
        try {
            var attributes = new SecurityAttributes {
                Length = Marshal.SizeOf(typeof(SecurityAttributes)), Descriptor = pinned.AddrOfPinnedObject()
            };
            if (!CreateDirectoryW(path, ref attributes))
                throw new System.ComponentModel.Win32Exception(Marshal.GetLastWin32Error());
        } finally { pinned.Free(); }
    }

    [DllImport("kernel32.dll", SetLastError = true)]
    [return: MarshalAs(UnmanagedType.Bool)]
    public static extern bool IsWow64Process2(IntPtr process, out ushort processMachine, out ushort nativeMachine);

    static int ReadFully(Stream stream, byte[] buffer, int count) {
        int total = 0;
        while (total < count) {
            int read = stream.Read(buffer, total, count - total);
            if (read == 0) break;
            total += read;
        }
        return total;
    }

    static long ParseOctal(byte[] block, int offset, int length) {
        int index = offset;
        int end = offset + length;
        while (index < end && (block[index] == 0x20 || block[index] == 0x00)) index++;
        long value = 0;
        int digits = 0;
        while (index < end && block[index] >= (byte)'0' && block[index] <= (byte)'7') {
            if (value > (long.MaxValue >> 3)) throw new InvalidDataException("Invalid native archive inventory");
            value = (value * 8L) + (block[index] - (byte)'0');
            digits++;
            index++;
        }
        if (digits == 0) throw new InvalidDataException("Invalid native archive inventory");
        while (index < end) {
            if (block[index] != 0x20 && block[index] != 0x00) throw new InvalidDataException("Invalid native archive inventory");
            index++;
        }
        return value;
    }

    // Extract using Win32 UTF-16 file APIs; Windows tar.exe mangles non-ACP Unicode paths.
    public static void ExtractSingleFileTarGz(string archivePath, string expectedName, string outputPath, long maxBytes) {
        using (var input = new FileStream(archivePath, FileMode.Open, FileAccess.Read, FileShare.Read))
        using (var gzip = new GZipStream(input, CompressionMode.Decompress)) {
            byte[] header = new byte[512];
            if (ReadFully(gzip, header, 512) != 512) throw new InvalidDataException("Invalid native archive inventory");
            long expectedChecksum = ParseOctal(header, 148, 8);
            long actualChecksum = 0;
            for (int i = 0; i < 512; i++) actualChecksum += (i >= 148 && i < 156) ? 0x20 : header[i];
            if (actualChecksum != expectedChecksum) throw new InvalidDataException("Invalid native archive inventory");
            byte typeFlag = header[156];
            if (typeFlag != (byte)'0' && typeFlag != 0) throw new InvalidDataException("Invalid native archive inventory");
            int nameLength = 0;
            while (nameLength < 100 && header[nameLength] != 0) nameLength++;
            string entryName = Encoding.UTF8.GetString(header, 0, nameLength);
            bool isUstar = header[257] == (byte)'u' && header[258] == (byte)'s' && header[259] == (byte)'t'
                && header[260] == (byte)'a' && header[261] == (byte)'r' && header[262] == 0;
            if (isUstar && header[345] != 0) throw new InvalidDataException("Invalid native archive inventory");
            if (!string.Equals(entryName, expectedName, StringComparison.Ordinal)) throw new InvalidDataException("Invalid native archive inventory");
            long size = ParseOctal(header, 124, 12);
            if (size <= 0 || size > maxBytes) throw new InvalidDataException("Invalid native archive inventory");
            bool created = false;
            try {
                using (var output = new FileStream(outputPath, FileMode.CreateNew, FileAccess.Write, FileShare.None)) {
                    created = true;
                    byte[] buffer = new byte[81920];
                    long remaining = size;
                    while (remaining > 0) {
                        int want = remaining > buffer.Length ? buffer.Length : (int)remaining;
                        int read = gzip.Read(buffer, 0, want);
                        if (read == 0) throw new InvalidDataException("Unable to extract native archive");
                        output.Write(buffer, 0, read);
                        remaining -= read;
                    }
                    output.Flush(true);
                }
                int padding = (int)((512L - (size % 512L)) % 512L);
                if (padding > 0 && ReadFully(gzip, header, padding) != padding) throw new InvalidDataException("Unable to extract native archive");
                int zeroBlocks = 0;
                while (true) {
                    int tail = ReadFully(gzip, header, 512);
                    if (tail == 0) break;
                    if (tail != 512) throw new InvalidDataException("Invalid native archive inventory");
                    for (int i = 0; i < 512; i++) {
                        if (header[i] != 0) throw new InvalidDataException("Invalid native archive inventory");
                    }
                    zeroBlocks++;
                }
                if (zeroBlocks < 2) throw new InvalidDataException("Invalid native archive inventory");
            } catch {
                if (created && File.Exists(outputPath)) File.Delete(outputPath);
                throw;
            }
        }
    }
}
'@
}
$processMachine = [System.UInt16]0; $nativeMachine = [System.UInt16]0
if (-not [VoyttyInstallerPlatform]::IsWow64Process2([IntPtr](-1), [ref]$processMachine, [ref]$nativeMachine)) { throw 'Unable to determine native Windows architecture' }
switch ($nativeMachine) {
    0x8664 { $target = 'x86_64-pc-windows-msvc' }
    0xAA64 { $target = 'aarch64-pc-windows-msvc' }
    default { throw "Unsupported Windows architecture: $nativeMachine (requires x64 or ARM64)" }
}
$artifact = @($artifacts | Where-Object { $_.target -eq $target })
if ($artifact.Count -ne 1) { throw 'Release is missing the native Windows target' }
$artifact = $artifact[0]
$InstallDir = [IO.Path]::GetFullPath($InstallDir)
function Assert-InstallDirectory([IO.DirectoryInfo]$Directory) {
    for ($node = $Directory; $null -ne $node; $node = $node.Parent) {
        try { $attributes = [IO.File]::GetAttributes($node.FullName) }
        catch [IO.FileNotFoundException] { continue }
        catch [IO.DirectoryNotFoundException] { continue }
        if (($attributes -band [IO.FileAttributes]::ReparsePoint) -or -not ($attributes -band [IO.FileAttributes]::Directory)) {
            throw "Unsafe installation directory: $node"
        }
    }
}
Assert-InstallDirectory $InstallDir
[IO.Directory]::CreateDirectory($InstallDir) | Out-Null
Assert-InstallDirectory $InstallDir
$destination = Join-Path $InstallDir 'voytty.exe'
if (Test-Path -LiteralPath $destination) { throw 'voytty.exe already exists; use voytty update' }
Add-Type -AssemblyName System.Net.Http
$handler = New-Object System.Net.Http.HttpClientHandler
$handler.AllowAutoRedirect = $false
$client = New-Object System.Net.Http.HttpClient($handler)
$client.Timeout = [TimeSpan]::FromMinutes(10)
$client.DefaultRequestHeaders.UserAgent.ParseAdd('voytty-installer')
$temporary = Join-Path $InstallDir ('.voytty-install-' + [guid]::NewGuid().ToString('N'))
# Protect staging before any downloaded executable or authentication data exists.
$sid = [Security.Principal.WindowsIdentity]::GetCurrent().User
# A private child ACL cannot prevent another account from deleting it via the parent.
$trusted = @($sid.Value, 'S-1-5-18', 'S-1-5-32-544')
$parentAcl = Get-Acl -LiteralPath $InstallDir
if ($parentAcl.GetOwner([Security.Principal.SecurityIdentifier]).Value -notin $trusted) { throw 'Untrusted install directory owner' }
foreach ($rule in $parentAcl.GetAccessRules($true, $true, [Security.Principal.SecurityIdentifier])) {
    if ($rule.AccessControlType -eq 'Allow' -and $rule.IdentityReference.Value -notin $trusted -and
        -not ($rule.PropagationFlags -band [Security.AccessControl.PropagationFlags]::InheritOnly) -and
        ([int64]$rule.FileSystemRights -band 0x500D0156)) { throw 'Install directory permits modification by another account' }
}
$acl = New-Object Security.AccessControl.DirectorySecurity
$acl.SetOwner($sid)
$acl.SetAccessRuleProtection($true, $false)
$acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($sid, 'FullControl', 'ContainerInherit,ObjectInherit', 'None', 'Allow')))
[VoyttyInstallerPlatform]::CreatePrivateDirectory($temporary, $acl.GetSecurityDescriptorBinaryForm())
function Get-BoundedAsset([string]$Name, [long]$Maximum) {
    $response = $null; $inputStream = $null; $output = $null
    $watch = [Diagnostics.Stopwatch]::StartNew()
    $deadline = New-Object Threading.CancellationTokenSource
    $deadline.CancelAfter(600000)
    try {
        $url = "$baseUrl/$Name"
        for ($redirect = 0; ; $redirect++) {
            if (([uri]$url).Scheme -ne 'https') { throw 'HTTPS is required' }
            $response = $client.GetAsync($url, [Net.Http.HttpCompletionOption]::ResponseHeadersRead, $deadline.Token).GetAwaiter().GetResult()
            if ([int]$response.StatusCode -notin @(301, 302, 303, 307, 308)) { break }
            if ($redirect -ge 5 -or -not $response.Headers.Location) { throw 'Invalid asset redirect' }
            $url = (New-Object Uri([uri]$url, $response.Headers.Location)).AbsoluteUri
            $response.Dispose()
        }
        $response.EnsureSuccessStatusCode() | Out-Null
        if ($response.Content.Headers.ContentLength -gt $Maximum) { throw 'Asset exceeds download bound' }
        $inputStream = $response.Content.ReadAsStreamAsync().GetAwaiter().GetResult()
        $output = [IO.File]::Open((Join-Path $temporary $Name), [IO.FileMode]::CreateNew, [IO.FileAccess]::Write, [IO.FileShare]::None)
        $buffer = New-Object byte[] 81920
        $count = 0L
        while ($true) {
            $pending = $inputStream.ReadAsync($buffer, 0, $buffer.Length, $deadline.Token)
            $remaining = [int][Math]::Max(1, [Math]::Min(30000, 600000 - $watch.ElapsedMilliseconds))
            if (-not $pending.Wait($remaining)) { throw 'Download stalled or exceeded its total deadline' }
            $read = $pending.GetAwaiter().GetResult()
            if ($read -eq 0) { break }
            $count += $read
            if ($count -gt $Maximum -or $watch.Elapsed.TotalSeconds -gt 600) { throw 'Download exceeded its bound' }
            $output.Write($buffer, 0, $read)
        }
        $output.Flush($true)
        return $count
    } finally {
        $deadline.Cancel(); $deadline.Dispose()
        if ($output) { $output.Dispose() }; if ($inputStream) { $inputStream.Dispose() }; if ($response) { $response.Dispose() }
    }
}
try {
    $null = Get-BoundedAsset 'voytty-release.json' 65536
    $manifest = Join-Path $temporary 'voytty-release.json'
    if ((Get-FileHash -LiteralPath $manifest -Algorithm SHA256).Hash.ToLowerInvariant() -ne $manifestHash) { throw 'Manifest hash mismatch' }
    if ((Get-BoundedAsset 'voytty-release.json.sig' 64) -ne 64) { throw 'Invalid manifest signature length' }
    $length = Get-BoundedAsset $artifact.filename $artifact.length
    $archive = Join-Path $temporary $artifact.filename
    if ($length -ne $artifact.length -or (Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne $artifact.sha256) { throw 'Archive authentication failed' }
    $candidate = Join-Path $temporary 'voytty.exe'
    [VoyttyInstallerPlatform]::ExtractSingleFileTarGz($archive, 'voytty.exe', $candidate, 268435456L)
    $attributes = [IO.File]::GetAttributes($candidate)
    if ($attributes -band ([IO.FileAttributes]::ReparsePoint -bor [IO.FileAttributes]::Directory)) { throw 'Expected a regular candidate executable' }
    $identity = & $candidate --internal-release-self-check | ConvertFrom-Json
    if ($LASTEXITCODE -ne 0 -or $identity.build.target -cne $target -or ('v' + $identity.build.version) -cne $releaseTag) { throw 'Candidate identity mismatch' }
    & $candidate --internal-release-verify $manifest (Join-Path $temporary 'voytty-release.json.sig')
    if ($LASTEXITCODE -ne 0) { throw 'Release signature verification failed' }
    Assert-InstallDirectory $InstallDir
    & $candidate --internal-release-install $destination
    if ($LASTEXITCODE -ne 0) { throw 'Atomic installation failed' }
    if (-not $NoPath) {
        $entries = @($env:Path -split ';' | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
        if (@($entries | ForEach-Object { $_.Trim().Trim('"').TrimEnd('\') }) -notcontains $InstallDir.TrimEnd('\')) { $entries += $InstallDir }
        $env:Path = $entries -join ';'
    }
    Write-Output "Add $InstallDir to your user PATH for future terminals."
    Write-Output "Installed voytty $releaseTag for $target to $destination. Run voytty setup."
} finally {
    $client.Dispose(); $handler.Dispose()
    Remove-Item -LiteralPath $temporary -Recurse -Force
}
